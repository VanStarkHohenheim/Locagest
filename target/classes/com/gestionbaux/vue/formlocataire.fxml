<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gestionbaux.controleur.FormLocataireControleur"
            prefHeight="350.0" prefWidth="500.0"
            style="-fx-padding: 20;">

    <top>
        <Label text="Ajouter un locataire"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 15 0;"/>
    </top>

    <center>
        <VBox spacing="8">
            <Label text="Nom"/>
            <TextField fx:id="champNom" promptText="Ex: Dupont"/>

            <Label text="Prénom"/>
            <TextField fx:id="champPrenom" promptText="Ex: Jean"/>

            <Label text="Email"/>
            <TextField fx:id="champEmail" promptText="Ex: jean.dupont@email.com"/>

            <Label text="Téléphone"/>
            <TextField fx:id="champTelephone" promptText="Ex: 06 12 34 56 78"/>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 15 0 0 0;">
            <Button text="Enregistrer" onAction="#enregistrerLocataire"/>
            <Button text="Annuler" onAction="#annuler"/>
        </HBox>
    </bottom>

</BorderPane>
