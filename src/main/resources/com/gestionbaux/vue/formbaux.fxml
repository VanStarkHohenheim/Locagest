<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.gestionbaux.controleur.FormBauxControleur"
            prefHeight="400.0" prefWidth="500.0"
            style="-fx-padding: 20;">

    <top>
        <Label text="Créer un bail"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 15 0;"/>
    </top>

    <center>
        <VBox spacing="8">
            <Label text="Locataire"/>
            <ComboBox fx:id="champLocataire" maxWidth="Infinity"/>

            <Label text="Appartement"/>
            <ComboBox fx:id="champAppartement" maxWidth="Infinity"/>

            <Label text="Date de début"/>
            <DatePicker fx:id="champDateDebut" maxWidth="Infinity"/>

            <Label text="Date de fin"/>
            <DatePicker fx:id="champDateFin" maxWidth="Infinity"/>

            <Label text="Loyer mensuel (€)"/>
            <TextField fx:id="champLoyer" promptText="Ex: 850"/>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 15 0 0 0;">
            <Button text="Enregistrer" onAction="#enregistrerBail"/>
            <Button text="Annuler"     onAction="#annuler"/>
        </HBox>
    </bottom>

</BorderPane>
