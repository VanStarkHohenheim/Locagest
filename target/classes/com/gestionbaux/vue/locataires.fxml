<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<!-- Écran de la liste des locataires -->
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestionbaux.controleur.LocatairesControleur"
            style="-fx-padding: 20;">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 0 0 15 0;">
            <Button text="← Accueil" onAction="#retourAccueil"/>
            <Label text="Liste des Locataires"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="tableLocataires">
            <placeholder>
                <Label text="Aucun locataire enregistré."/>
            </placeholder>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="10" style="-fx-padding: 15 0 0 0;">
            <Button text="Ajouter" onAction="#ajouterLocataire"/>
            <Button fx:id="btnSupprimer" text="Supprimer" onAction="#supprimerLocataire"/>
        </HBox>
    </bottom>

</BorderPane>
